DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gas_delivery"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
PORT=3333
# Token do Mapbox (usado só no servidor, para calcular rotas)
MAPBOX_TOKEN=""
# Distância máxima (em metros) entre o motoboy e o endereço para marcar como entregue
DELIVERY_RADIUS_M=150
# Usuário admin criado pelo seed
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD="trocar123"
# Busca por endereço: chave do plano gratuito Geoapify (somente backend)
GEOAPIFY_API_KEY=""
# Desenvolvimento: origens exatas, sem barra final
APP_ORIGINS=http://localhost:5173,http://localhost:3333
HOST=127.0.0.1
# Em produção, confiar apenas no proxy local (Caddy), com a API inacessível externamente
# TRUST_PROXY=loopback
# Mapa básico: false desativa tiles OpenStreetMap, mantendo pontos e links externos
MAP_TILES_ENABLED=true
